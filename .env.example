# Copy to .env and replace values before running outside local development.
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
SESSION_COOKIE_SECURE=0

# Optional SMTP email delivery. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=

# Optional Twilio SMS delivery.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Use Redis for limits shared across multiple workers in production.
RATELIMIT_STORAGE_URI=memory://
